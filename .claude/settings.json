{
  "model": "deepseek-flash",
  "apiKeyHelper": "printenv DEEPSEEK_API_KEY",
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_MODEL": "deepseek-flash",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": ["Read", "Grep", "Glob", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)"],
    "deny": [
      "Edit", "Write", "WebFetch", "WebSearch",
      "Bash(dotnet:*)", "Bash(gradle:*)", "Bash(./gradlew:*)", "Bash(pip:*)", "Bash(npm:*)", "Bash(pnpm:*)",
      "Bash(python:*)", "Bash(pytest:*)", "Bash(curl:*)", "Bash(wget:*)", "Bash(ssh:*)",
      "Bash(git push:*)", "Bash(git merge:*)", "Bash(git rebase:*)", "Bash(git reset:*)", "Bash(git branch -D:*)",
      "Read(./**/.env)", "Read(./**/*.env)"
    ]
  }
}

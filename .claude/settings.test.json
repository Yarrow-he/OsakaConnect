{
  "_comment": "测试：Claude Code + DeepSeek。用法：claude --settings .claude/settings.tester.json。key 只从环境变量 DEEPSEEK_API_KEY 取。",
  "model": "deepseek-flash",
  "apiKeyHelper": "printenv DEEPSEEK_API_KEY",
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_MODEL": "deepseek-flash",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(tests/**)",
      "Write(tests/**)",
      "Edit(notes/**)",
      "Write(notes/**)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(./gradlew assembleDebug:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew connectedDebugAndroidTest:*)",
      "Bash(bash tests/*)",
      "Bash(adb:*)",
      "Bash(emulator:*)",
      "Bash(avdmanager list:*)",
      "Bash(VBoxManage:*)",
      "Bash(virsh:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Edit(.codex/**)",
      "Edit(.claude/**)",
      "Write(.codex/**)",
      "Write(.claude/**)",
      "Bash(ip route:*)",
      "Bash(route:*)",
      "Bash(ip rule:*)",
      "Bash(iptables:*)",
      "Bash(nft:*)",
      "Bash(ufw:*)",
      "Bash(firewall-cmd:*)",
      "Bash(netsh:*)",
      "Bash(resolvectl:*)",
      "Bash(systemd-resolve:*)",
      "Bash(networksetup:*)",
      "Bash(scutil:*)",
      "Bash(gsettings set org.gnome.system.proxy:*)",
      "Bash(export http_proxy:*)",
      "Bash(export https_proxy:*)",
      "Bash(sudo:*)",
      "Bash(pip install:*)",
      "Bash(npm:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git branch -D:*)",
      "Read(./**/.env)",
      "Read(./**/*.env)",
      "Read(/etc/resolv.conf)"
    ]
  }
}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_4yM4FJbPgAwGmQ4FJebW9597","type":"tool_result","content":"# 契约测试：openapi/admin.v1.yaml 合法，且 shared/test-vectors/admin-contract.json 正反例结果符合预期。\n# CI 依赖（仅测试）：pyyaml、jsonschema、openapi-spec-validator。\nimport json, pathlib, yaml, jsonschema, pytest\nfrom openapi_spec_validator import validate\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nSPEC = yaml.safe_load((ROOT / \"openapi/admin.v1.yaml\").read_text(encoding=\"utf-8\"))\nVEC = json.loads((ROOT / \"shared/test-vectors/admin-contract.json\").read_text(encoding=\"utf-8\"))\n\ndef test_spec_valid():\n    validate(SPEC)\n\ndef schema(name):\n    return {\"$ref\": f\"#/components/schemas/{name}\", \"components\": SPEC[\"components\"]}\n\nCASES = [(n, s, ok) for n, v in VEC.items() if not n.startswith(\"_\") for ok in (True, False) for s in v[\"valid\" if ok else \"invalid\"]]\n\n@pytest.mark.parametrize(\"name,sample,ok\", CASES)\ndef test_vectors(name, sample, ok):\n    v = jsonschema.Draft202012Validator(schema(name))\n    assert v.is_valid(sample) == ok, (name, sample)\n=== server tests ===\n/home/box/osaka/wt/tests/tests/server/server-core/__pycache__/test_server_core.cpython-313-pytest-9.1.1.pyc\n/home/box/osaka/wt/tests/tests/server/server-core/test_server_core.py","is_error":false}]},"parent_tool_use_id":null,"session_id":"29f1ea7a-4662-4327-bf9c-839f1bc0a805","uuid":"9c9c352d-1a12-4fbe-bd97-ea197324b82b","timestamp":"2026-11-02T05:02:17.638Z","tool_use_result":{"stdout":"# 契约测试：openapi/admin.v1.yaml 合法，且 shared/test-vectors/admin-contract.json 正反例结果符合预期。\n# CI 依赖（仅测试）：pyyaml、jsonschema、openapi-spec-validator。\nimport json, pathlib, yaml, jsonschema, pytest\nfrom openapi_spec_validator import validate\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nSPEC = yaml.safe_load((ROOT / \"openapi/admin.v1.yaml\").read_text(encoding=\"utf-8\"))\nVEC = json.loads((ROOT / \"shared/test-vectors/admin-contract.json\").read_text(encoding=
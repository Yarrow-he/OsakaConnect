{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_dwp5AqsOiCaNelvPKTbq5667","type":"tool_result","content":"1\t// 用途：A3 统一错误展示。注入 shared/errors.json 的每个错误码，断言显示文案等于共享中文文案，\n2\t//       且不含堆栈标记 \"at \" 或异常类型名。\n3\t// 前置环境：Windows + .NET 8 SDK；产品类型 ErrorPresenter 已交付并与 ProductSurface.cs 对齐。\n4\t// 运行命令：dotnet test tests/windows/win-diagnostics -c Release\n5\t// 覆盖 acceptance：A3\n6\t// 待 CI：本机不装 .NET，未在本机运行；由 GitHub Actions windows-latest 执行。\n7\tusing Xunit;\n8\t\n9\tpublic sealed class ErrorPresenterTests\n10\t{\n11\t    [ProductFact(ProductSurface.ErrorPresenterType)]\n12\t    public void A3_KnownErrorCodesShowSharedChineseTextWithoutStackTrace()\n13\t    {\n14\t        var type = ProductSurface.ResolveOrThrow(ProductSurface.ErrorPresenterType);\n15\t        var errors = SharedVectors.LoadErrors();\n16\t        Assert.NotEmpty(errors);\n17\t\n18\t        foreach (var (code, entry) in errors)\n19\t        {\n20\t            // 注入一个错误：后台 ErrorBody 的 code，文案唯一事实来源是 shared/errors.json。\n21\t            var shown = ProductSurface.Call(type, ProductSurface.ErrorPresenterMethod, code) as string;\n22\t\n23\t            Assert.False(string.IsNullOrWhiteSpace(shown), $\"{code} 未显示用户可读文案\");\n24\t            Assert.Equal(entry.Zh, shown);\n25\t            Assert.DoesNotContain(\"at \", shown!);\n26\t            Assert.DoesNotContain(\"Exception\", shown!);\n27\t            Assert.DoesNotContain(\"System.\", shown!);\n28\t            Assert.DoesNotContain(\"StackTrace\", shown!);\n29\t        }\n30\t    }\n31\t}\n32\t"}]},"parent_tool_use_id":null,"session_id":"ec7e012c-bf97-4a00-b1a5-b32ee1d3c38b","uuid":"a213917c-3e27-453a-9138-52c9bf1307cb","timestamp":"2026-11-02T05:05:06.090Z","tool_use_result":{"type":"text","file":{"filePath":"/home/box/osaka/wt/tests/tests/windows/win-diagnostics/ErrorPresenterTests.cs","content":"// 用途：A3 统一错误展示。注入 shared/errors.json 的每个错误码，断言显示文案等于共享中文文案，\n//       且不含堆栈标记 \"at \" 或异常类型名。\n// 前置环境：Windows + .NET 8 SDK；产品类型 ErrorPresenter 已交付并与 ProductSurface.cs 对齐。\n// 运行命令：dotnet test tests/windows/win-diagnostics -c Release\n// 覆盖 acceptance：A3\n// 待 CI：本机不装 .NET，未在本机运行；由 GitHub Actions windows-latest 执行。\nusing Xunit;\n\npublic sealed class ErrorPresenterTests\n{\n    [ProductFact(ProductSurface.ErrorPresenterType)]\n    public void A3_KnownErrorCodesShowSharedChineseTextWithoutStackTrace()\n    {\n        var type = ProductSurface.ResolveOrThrow(ProductSurface.ErrorPresenterType);\n        var errors = SharedVectors.LoadErrors();\n        Assert.NotEmpty(errors);\n\n        foreach (var (code, entry) in errors)\n        {\n            // 注入一个错误：后台 ErrorBody 的 code，文案唯一事实来源是 shared/errors.json。\n            var shown = ProductSurface.Call(type, ProductSurface.ErrorPresenterMethod, code) as string;\n\n            Assert.False(string.IsNullOrWhiteSpace(shown), $\"{code} 未显示用户可读文案\");\n            Assert.Equal(entry.Zh, shown);\n            Assert.DoesNotContain(\"at \", shown!);\n            Assert.DoesNotContain(\"Exception\", shown!);\n            Assert.DoesNotContain(\"System.\", shown!);\n            Assert.DoesNotContain(\"StackTrace\", shown!);\n        }\n    }\n}\n","numLines":32,"startLine":1,"totalLines":32}},"tool_result_meta":[{"id":"call_00_dwp5AqsOiCaNelvPKTbq5667","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

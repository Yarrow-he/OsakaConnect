>\n  </ItemGroup>\n\n  <ItemGroup>\n    <PackageReference Include=\"Microsoft.NET.Test.Sdk\" Version=\"17.11.1\" />\n    <PackageReference Include=\"xunit\" Version=\"2.9.2\" />\n    <PackageReference Include=\"xunit.runner.visualstudio\" Version=\"2.8.2\">\n      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>\n      <PrivateAssets>all</PrivateAssets>\n    </PackageReference>\n  </ItemGroup>\n</Project>\n","structuredPatch":[{"oldStart":3,"oldLines":6,"newStart":3,"newLines":7,"lines":["     用途：win-diagnostics 的 xUnit 测试工程，覆盖 A3（错误文案）、A4（日志脱敏）、A15（邀请码）。","     前置环境：Windows + .NET 8 SDK；共享向量从仓库 shared/ 按相对路径读取。","     运行命令：dotnet test tests/windows/win-diagnostics -c Release","+    覆盖 acceptance：A3、A4、A15","     待 CI：本机不装 .NET，未在本机构建/运行；由 GitHub Actions windows-latest 执行。","   -->","   <PropertyGroup>"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"call_00_jkCSsZQD8Ql9OR5bPV098597","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

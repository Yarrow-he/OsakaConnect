n: echo \"code=$(ls windows/*.sln admin/*.sln windows/**/*.csproj admin/**/*.csproj 2>/dev/null | head -1)\" >> \"$GITHUB_OUTPUT\"\n      - if: steps.has.outputs.code == ''\n        run: echo \"无 .NET 代码，跳过\"\n      - if: steps.has.outputs.code != ''\n        uses: actions/setup-dotnet@v4\n        with: { dotnet-version: '8.0.x' }\n      - if: steps.has.outputs.code != ''\n        shell: bash\n        run: |\n          for d in windows admin; do [ -d \"$d\" ] && (cd \"$d\" && dotnet build -c Release && dotnet test -c Release --no-build); done\n  android:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - id: has\n        run: echo \"code=$([ -f android/gradlew ] && echo y)\" >> \"$GITHUB_OUTPUT\"\n      - if: steps.has.outputs.code == ''\n        run: echo \"无 Android 代码，跳过\"\n      - if: steps.has.outputs.code != ''\n        uses: actions/setup-java@v4\n        with: { distribution: temurin, java-version: '17' }\n      - if: steps.has.outputs.code != ''\n        working-directory: android\n        run: ./gradlew --no-daemon assembleDebug testDebugUnitTest\n  python:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - id: has\n        run: echo \"code=$([ -d server ] && ls server/*.py server/**/*.py 2>/dev/null | head -1)\" >> \"$GITHUB_OUTPUT\"\n      - if: steps.has.outputs.code == ''\n        run: echo \"无 Python 代码，跳过\"\n      - if: steps.has.outputs.code != ''\n        uses: actions/setup-python@v5\n        with: { python-version: '3.12' }\n      - if: steps.has.outputs.code != ''\n        working-directory: server\n        run: |\n          [ -f requirements.txt ] && pip install -r requirements.txt\n          pip install pytest && pytest -q\n","numLines":71,"startLine":1,"totalLines":71}},"tool_result_meta":[{"id":"call_02_8fnz4semx5U47u1NA94X1518","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

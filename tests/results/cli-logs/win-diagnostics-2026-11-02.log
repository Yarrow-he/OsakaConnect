{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_aMxQcXKexJovY7EZASx86306","type":"tool_result","content":"1\t// 用途：win-diagnostics 产品入口的唯一对齐点。产品未交付时，测试在发现阶段以\n2\t//       “待测：模块未交付”跳过，而不是编译失败或伪装通过。\n3\t// 前置环境：Windows + .NET 8 SDK；产品工程已由写手交付。\n4\t// 运行命令：dotnet test tests/windows/win-diagnostics -c Release\n5\t// 覆盖 acceptance：A3、A4、A15（供各测试文件引用）。\n6\tusing System.Reflection;\n7\tusing Xunit;\n8\t\n9\t// 待写手交付后对齐：命名空间、程序集名与入口方法名是 brief 占位值，不是最终事实。\n10\t// 写手交付后只改这里（及 WinDiagnostics.Tests.csproj 的 ProductProject）。\n11\tinternal static class ProductSurface\n12\t{\n13\t    internal const string ProductAssembly = \"OsakaConnect.Windows\";\n14\t    internal const string Namespace = \"OsakaConnect.Windows.Diagnostics\";\n15\t\n16\t    internal const string ErrorPresenterType = Namespace + \".ErrorPresenter\";\n17\t    internal const string ErrorPresenterMethod = \"Present\"; // 待写手交付后对齐：错误码 → 中文文案\n18\t\n19\t    internal const string LogRedactorType = Namespace + \".LogRedactor\";\n20\t    internal const string LogRedactorMethod = \"Redact\"; // 待写手交付后对齐：日志文本 → 脱敏文本\n21\t\n22\t    internal const string InviteCodeType = Namespace + \".InviteCode\";\n23\t    internal const string InviteCodeIsValidMethod = \"IsValid\"; // brief 已给出\n24\t\n25\t    internal const string NotDelivered = \"待测：模块未交付\";\n26\t\n27\t    internal static Type? TryResolve(string fullTypeName)\n28\t    {\n29\t        foreach (var assembly in AppDomain.CurrentDomain.GetAssemblies())\n30\t        {\n31\t            if (assembly.IsDynamic)\n32\t                continue;\n33\t            if (assembly.GetType(fullTypeName, throwOnError: false) is { } found)\n34\t                return found;\n35\t        }\n36\t\n37\t        try\n38\t        {\n39\t            return Assembly.Load(new AssemblyName(ProductAssembly))\n40\t                .GetType(fullTypeName, throwOnError: false);\n41\t        }\n42\t        catch (Exception)\n43\t        {\n44\t            return null;\n45\t        }\n46\t    }\n47\t\n48\t    internal static Type ResolveOrThrow(string fullTypeName) =>\n49\t        TryResolve(fullTypeName)\n50\t        ?? throw new InvalidOperationException(\n51\t            $\"{NotDelivered}（找不到 {fullTypeName}；请对齐 ProductSurface 顶部常量）。\");\n52\t\n53\t    // 入口按类型/方法名反射调用，避免在产品未交付时引用不存在的编译期符号。\n54\t    internal static object? Call(Type type, string methodName, params object?[] args)\n55\t    {\n56\t        var method = type\n57\t            .GetMethods(BindingFlags.Public | BindingFlags.Static | BindingFlags.Instance)\n58\t            .FirstOrDefault(m => m.Name == methodName && ShapeMatches(m, args))\n59\t            ?? throw new InvalidOperationException(\n60\t                $\"找不到入口 {type.FullName}.{methodName}/{args.Length}；请对齐 ProductSurface 顶部常量。\");\n61\t\n62\t        var target = method.IsStatic ? null : Activator.CreateInstance(type);\n63\t        return method.Invoke(target, args);\n64\t    }\n65\t\n66\t    private static bool ShapeMatches(MethodInfo method, object?[] args)\n67\t    {\n68\t        var parameters = method.GetParameters();\n69\t        if (parameters.Length != args.Length)\n70\t            return false;\n71\t\n72\t        for (var i = 0; i < parameters.Length; i++)\n73\t        {\n74\t            var value = args[i];\n75\t            if (value is null)\n76\t            {\n77\t                if (parameters[i].ParameterType.IsValueType)\n78\t                    return false;\n79\t            }\n80\t            else if (!parameters[i].ParameterType.IsInstanceOfType(value))\n81\t            {\n82\t                return false;\n83\t            }\n84\t        }\n85\t\n86\t        return true;\n87\t    }\n88\t}\n89\t\n90\t// 产品类型不存在时报告 skip；存在时正常执行。\n91\tpublic sealed class ProductFactAttribute : FactAttribute\n92\t{\n93\t    public ProductFactAttribute(string productType)\n94\t    {\n95\t        if (ProductSurface.TryResolve(productType) is null)\n96\t            Skip = ProductSurface.NotDelivered;\n97\t    }\n98\t}\n99\t"
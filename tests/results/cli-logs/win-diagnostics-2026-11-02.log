n!);\n            Assert.DoesNotContain(\"System.\", shown!);\n            Assert.DoesNotContain(\"StackTrace\", shown!);\n        }\n    }\n}\n","structuredPatch":[{"oldStart":20,"oldLines":6,"newStart":20,"newLines":7,"lines":["             // 注入一个错误：后台 ErrorBody 的 code，文案唯一事实来源是 shared/errors.json。","             var shown = ProductSurface.Call(type, ProductSurface.ErrorPresenterMethod, code) as string;"," ","+            Assert.NotNull(shown);","             Assert.False(string.IsNullOrWhiteSpace(shown), $\"{code} 未显示用户可读文案\");","             Assert.Equal(entry.Zh, shown);","             Assert.DoesNotContain(\"at \", shown!);"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"call_00_gdk6ozMapwFQUDwwUtV75799","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

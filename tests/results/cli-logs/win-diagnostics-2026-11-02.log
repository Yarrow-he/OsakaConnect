hod, item.In) as string;"," ","-            Assert.False(redacted is null, $\"redaction 向量 #{i} 没有输出\");","+            Assert.NotNull(redacted);","             Assert.Equal(item.Out, redacted);","         }","     }"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"call_01_NMcttCBHbYL811ym3mo72109","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

 new InvalidOperationException(\"invite-code.json 解析为空\");\n37\t}\n38\t\n39\tinternal sealed class ErrorEntry\n40\t{\n41\t    public int Http { get; set; }\n42\t    public string Zh { get; set; } = \"\";\n43\t}\n44\t\n45\tinternal sealed class RedactionVectors\n46\t{\n47\t    [JsonPropertyName(\"mask\")] public string Mask { get; set; } = \"\";\n48\t    [JsonPropertyName(\"cases\")] public List<RedactionCase> Cases { get; set; } = new();\n49\t}\n50\t\n51\tinternal sealed class RedactionCase\n52\t{\n53\t    [JsonPropertyName(\"in\")] public string In { get; set; } = \"\";\n54\t    [JsonPropertyName(\"out\")] public string Out { get; set; } = \"\";\n55\t}\n56\t\n57\tinternal sealed class InviteCodeVectors\n58\t{\n59\t    [JsonPropertyName(\"valid\")] public List<string?> Valid { get; set; } = new();\n60\t    [JsonPropertyName(\"invalid\")] public List<string?> Invalid { get; set; } = new();\n61\t}\n62\t"}]},"parent_tool_use_id":null,"session_id":"ec7e012c-bf97-4a00-b1a5-b32ee1d3c38b","uuid":"d0ac94ce-4065-408f-87a9-c8038b9e1202","timestamp":"2026-11-02T05:04:40.570Z","tool_use_result":{"type":"text","file":{"filePath":"/home/box/osaka/wt/tests/tests/windows/win-diagnostics/SharedVectors.cs","content":"// 用途：按相对仓库根路径读取 shared/errors.json 与 shared/test-vectors/*.json。\n// 前置环境：Windows + .NET 8 SDK；仓库结构保持 shared/ 在根目录。\n// 运行命令：dotnet test tests/windows/win-diagnostics -c Release\n// 覆盖 acceptance：A3（errors.json）、A4（redaction.json）、A15（invite-code.json）。\nusing System.Text.Json;\nusing System.Text.Json.Serialization;\n\ninternal static class SharedVectors\n{\n    private static readonly JsonSerializerOptions Options = new() { PropertyNameCaseInsensitive = true };\n\n    private static string RepoRoot()\n    {\n        for (var dir = new DirectoryInfo(AppContext.BaseDirectory); dir is not null; dir = dir.Parent)\n        {\n            if (Directory.Exists(Path.Combine(dir.FullName, \"shared\", \"test-vectors\")))\n                return dir.FullName;\n        }\n\n      
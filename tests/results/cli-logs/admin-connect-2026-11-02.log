./../..}\n      dockerfile: ${PROBE_DOCKERFILE:-admin/Dockerfile.probe}\n    image: ${PROBE_IMAGE:-osaka-admin-probe:local}\n    depends_on:\n      osaka-server:\n        condition: service_healthy\n    volumes:\n      - ${CERTS_DIR:?CERTS_DIR required}/trusted/ca.crt:/usr/local/share/ca-certificates/osaka-test-ca.crt:ro\n      - ${CERTS_DIR:?CERTS_DIR required}:/certs:ro\n    environment:\n      OSAKA_ADMIN_TOKEN: ${PROBE_TOKEN:?PROBE_TOKEN required}\n      SSL_CERT_FILE: /certs/trusted/ca.crt\n      PROBE_BIN: ${PROBE_BIN:-/app/probe}\n      PROBE_URL: ${PROBE_URL:-https://osaka-server:8443}\n    # 把临时 CA 注入系统信任库后，再跑产品自带的 probe 入口\n    entrypoint: [\"/bin/sh\", \"-c\"]\n    command:\n      - |\n        update-ca-certificates >/dev/null 2>&1 || true\n        exec \"$$PROBE_BIN\" --probe \"$$PROBE_URL\"\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"call_00_YNr5uZvUXmffDBXJV9ON6625","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

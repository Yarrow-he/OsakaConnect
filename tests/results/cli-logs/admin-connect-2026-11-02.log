KEN:?OSAKA_ADMIN_TOKEN required}\n    volumes:\n      - ${OSAKA_ROOT:-../../..}/server:/workspace/server:ro\n      - ${CERTS_DIR:?CERTS_DIR required}:/certs:ro\n    # 仅探 TCP 端口，不做 TLS 校验，保证 ③④ 场景下也能等到后台就绪\n    healthcheck:\n      test: [\"CMD\", \"python\", \"-c\", \"import socket; socket.create_connection(('osaka-server', 8443), 3).close()\"]\n      interval: 2s\n      timeout: 5s\n      retries: 30\n\n  osaka-probe:\n    build:\n      context: ${PROBE_BUILD_CONTEXT:-../../..}\n      dockerfile: ${PROBE_DOCKERFILE:-admin/Dockerfile.probe}\n    image: ${PROBE_IMAGE:-osaka-admin-probe:local}\n    depends_on:\n      osaka-server:\n        condition: service_healthy\n    volumes:\n      - ${CERTS_DIR:?CERTS_DIR required}/trusted/ca.crt:/usr/local/share/ca-certificates/osaka-test-ca.crt:ro\n      - ${CERTS_DIR:?CERTS_DIR required}:/certs:ro\n    environment:\n      OSAKA_ADMIN_TOKEN: ${PROBE_TOKEN:?PROBE_TOKEN required}\n      SSL_CERT_FILE: /certs/trusted/ca.crt\n      PROBE_BIN: ${PROBE_BIN:-/app/probe}\n      PROBE_URL: ${PROBE_URL:-https://osaka-server:8443}\n    # 把临时 CA 注入系统信任库后，再跑产品自带的 probe 入口\n    entrypoint: [\"/bin/sh\", \"-c\"]\n    command:\n      - |\n        update-ca-certificates >/dev/null 2>&1 || true\n        exec \"$$PROBE_BIN\" --probe \"$$PROBE_URL\"\n","structuredPatch":[{"oldStart":18,"oldLines":10,"newStart":18,"newLines":10,"lines":["       PYTHONPATH: /workspace","       OSAKA_TLS_CERT: /certs/${OSAKA_CERT_SET:-trusted}/server.crt","       OSAKA_TLS_KEY: /certs/${OSAKA_CERT_SET:-trusted}/server.key","-      OSAKA_ADMIN_TOKEN: ${OSAKA_ADMIN_TOKEN:?OSAKA_ADMIN_TOKEN required}","+      OSAKA_ADMIN_TOKEN: \"${OSAKA_ADMIN_TOKEN:?OSAKA_ADMIN_TOKEN required}\"","     volumes:","-      - ${OSAKA_ROOT:-../../..}/server:/workspace/server:ro","-      - ${CERTS_DIR:?CERTS_DIR required}:/certs:ro","+      - \"${OSAKA_ROOT:-../../..}/server:/workspace/server:ro\"","+      - \"${CERTS_DIR:?CERTS_DIR required}:/certs:ro\"","     # 仅探 TCP 端口，不做 TLS 校验，保证 ③④ 场景
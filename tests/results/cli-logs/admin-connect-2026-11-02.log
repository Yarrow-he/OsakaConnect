\"-c\", \"import socket; socket.create_connection(('osaka-server', 8443), 3).close()\"]\n      interval: 2s\n      timeout: 5s\n      retries: 30\n\n  osaka-probe:\n    build:\n      context: ${PROBE_BUILD_CONTEXT:-../../..}\n      dockerfile: ${PROBE_DOCKERFILE:-admin/Dockerfile.probe}\n    image: ${PROBE_IMAGE:-osaka-admin-probe:local}\n    depends_on:\n      osaka-server:\n        condition: service_healthy\n    volumes:\n      - ${CERTS_DIR:?CERTS_DIR required}/trusted/ca.crt:/usr/local/share/ca-certificates/osaka-test-ca.crt:ro\n      - ${CERTS_DIR:?CERTS_DIR required}:/certs:ro\n    environment:\n      OSAKA_ADMIN_TOKEN: ${PROBE_TOKEN:?PROBE_TOKEN required}\n      SSL_CERT_FILE: /certs/trusted/ca.crt\n      PROBE_BIN: ${PROBE_BIN:-/app/probe}\n      PROBE_URL: ${PROBE_URL:-https://osaka-server:8443}\n    # 把临时 CA 注入系统信任库后，再跑产品自带的 probe 入口\n    entrypoint: [\"/bin/sh\", \"-c\"]\n    command:\n      - |\n        update-ca-certificates >/dev/null 2>&1 || true\n        exec \"$$PROBE_BIN\" --probe \"$$PROBE_URL\"\n","structuredPatch":[{"oldStart":5,"oldLines":7,"newStart":5,"newLines":8,"lines":[" # 前置环境：GitHub Actions ubuntu-latest + docker compose（待 CI）；本机不跑构建、不装 .NET/JDK。"," # 运行命令：tests/admin/admin-connect/run-a10.sh（本文件不要单独起）。"," # 覆盖 acceptance：A10（①可信证书+正确令牌、②错误令牌、③非受信 CA、④主机名不匹配）、A14（probe 为 .NET 入口）。","-# 待写手交付后对齐：SERVER_CMD、PROBE_DOCKERFILE、PROBE_BIN 的默认值以 server/、admin/ 实际入口为准。","+# 待写手交付后对齐：SERVER_CMD、PROBE_DOCKERFILE、PROBE_BUILD_CONTEXT、PROBE_BIN 的默认值","+# 以 server/、admin/ 实际入口为准。"," "," services:","   osaka-server:"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"call_03_5gDWKDXuOk5bS2ew2Bj76228","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

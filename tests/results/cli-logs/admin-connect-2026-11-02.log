|ts|tsx|c|h|cc|cpp|cxx|hpp|rs|go|rb|php|swift|m|mm|dart|lua|pl|r|jl|ex|exs|erl|hs|clj|sh|bash\n\nAlso `asm`, `s`, `zig`, `nim`, `v`. Maybe overkill. Keep a reasonable broad list. The key is avoid false failure on config/resources while catching other languages. Add `fs`, `vb` (since .NET could sneak F#/VB). Good.\n\nAlso, `xaml` under server would be a violation (allowed only py). Good.\n\nNow, `.csproj` under server → source file, ext csproj, allowed only py → violation. Good.\n\nWhat about files with uppercase extensions `.CS`? Use lowercase conversion: `ext=$(printf '%s' \"${f##*.}\" | tr '[:upper:]' '[:lower:]')`. Add. Case-insensitive filesystems. Do it in both is_source_file and check_lang. `is_source_file` case patterns are lowercase; convert inside.\n\nLet me write.\n\nAlso the requirement \"源码 grep 无 ServerCertificateCustomValidationCallback / 返回 true 的放行回调\": Our grep flags the callback name regardless. Add a note in output about \"返回 true\" being covered because any such callback is banned. Fine.\n\nLet me write grep-guard.sh.","signature":"751bcc7f-2ae0-492d-acb4-3262e50ac930"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":253,"cache_creation_input_tokens":0,"cache_read_input_tokens":56704,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"85b5f7a4-f572-472d-8399-89c76017bd29","uuid":"bd12128e-dcbd-429a-878f-86063e1057bc","timestamp":"2026-11-02T05:05:03.551Z","thinking_duration_ms":7748,"thinking_display":"updates"}
{"type":"assistant","message":{"id":"751bcc7f-2ae0-492d-acb4-3262e50ac930","type":"message","role":"assistant","model":"deepseek-flash","content":[{"type":"tool_use","id":"call_00_f7lrRTIboWrvra3wbDCz0442","name":"Write","input":{"file_path":"/home/box/osaka/wt/tests/tests/admin/admin-connect/grep-guard.sh","content":"#!/usr/bin/env bash\n# 用途：A14 技术栈检查（windows/admin 只出现 C#/.NET 源码，android 只出现 Kotlin/KTS，\n#       server 只出现 Python；资源与配置文件忽略；docs/architecture.md 技术栈一致），\n#       以及 A10 源码 grep：不得出现 ServerCertificateCustomValidationCallback 等\n#       证书校验放行回调（任一此类回调都视为违例，返回值 true 自然包含在内）。\n# 前置环境：bash、find、grep；产品代码已 checkout（GitHub Actions ubuntu-latest；待 CI）。\n# 运行命令：tests/admin/admin-connect/grep-guard.sh\n# 覆盖 acceptance：A10（无跳过证书校验的回调）、A14（技术栈锁定）。\nset -euo pipefail\n\nROOT=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/../../..\" && pwd)\nVIOLATIONS=0\n\nviolation() { echo \"违例：$*\"; VIOLATIONS=$((VIOLATIONS + 1)); }\n\npresent=0\nfor d in windows admin android server; do [ -d \"$ROOT/$d\" ] && present=1; done\nif [ \"$present\" -eq 0 ]; then\n  echo \"待测：模块未交付（windows/ admin/ android/ server/ 均不存在）\"\n  exit 0\nfi\n\n# A14 按“生产源码扩展名”判定；json/xml/png/gradle.properties 等资源与配置不在此列。\nis_source_file() {\n  local ext\n  ext=$(printf '%s' \"${1##*.}\" | tr '[:upper:]' '[:lower:]')\n  case \"$ext\" in\n    cs|csproj|xaml|fs|fsx|vb|py|pyw|java|kt|kts|scala|groovy|gradle|js|jsx|mjs|cjs|ts|tsx|\\\n    c|h|cc|cpp|cxx|hpp|rs|go|rb|php|swift|m|mm|dart|lua|pl|r|jl|ex|exs|erl|hs|clj|sh|bash)\n      return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\ncheck_lang() { # $1=目录 $2=允许的源码扩展名（|ext|ext|） $3=端名\n  local dir=\"$1\" allowed=\"$2\" label=\"$3\" f ext\n  if [ ! -d \"$dir\" ]; then\n    echo \"待测：模块未交付（$label 目录不存在）\"\n    return\n  fi\n  if [ -z \"$(find \"$dir\" -type f -print -quit)\" ]; then\n    echo \"待测：模块未交付（$label 目录为空）\"\n    return\n  fi\n  while IFS= read -r f; do\n    is_source_file \"$f\" || continue\n    ext=$(printf '%s' \"${f##*.}\" | tr '[:upper:]' '[:lower:]')\n    case \"$allowed\" in\n      *\"|$ext|\"*) ;;\n      *) violation \"${f#\"$ROOT\"/}（$label 不允许 .$ext 源码）\" ;;\n    esac\n  done < <(find \"$dir\" -type f | sort)\n}\n\ncheck_lang \"$ROOT/windows\" \"|cs|csproj|xaml|\" \"Windows\"\ncheck_lang \"$ROOT/admin\" \"|cs|csproj|xaml|\" \"管理端\"\ncheck_lang \"$ROOT/android\" \"|kt|kts|\" \"Android\"\ncheck_lang \"$ROOT/server\" \"|py|\" \"后台\"\n\nARCH=\"$ROOT/docs/architecture.md\"\nif [ -f \"$ARCH\" ]; then\n  section=$(awk '/^## 技术栈/{flag=1;next}/^## /{flag=0}flag' \"$ARCH\")\n  for word in \".NET\" \"Kotlin\" \"Python\"; do\n    printf '%s' \"$section\" | grep -Fq \"$word\" || violation \"docs/architecture.md 技术栈一节缺少 $word\"\n  done\nfi\n\nCALLBACK_PATTERN='ServerCertificateCustomValidationCallback|ServerCertificateValidationCallback|DangerousAcceptAnyServerCertificateValidator|RemoteCertificateValidationCallback'\ncheck_callbacks() {\n  local dirs=() d hits\n  for d in windows admin android server; do\n    [ -d \"$ROOT/$d\" ] && dirs+=(\"$ROOT/$d\")\n  done\n  [ ${#dirs[@]} -eq 0 ] && return\n  hits=$(grep -RInE \\\n    --exclude-dir=bin --exclude-dir=obj --exclude-dir=build --exclude-dir=.gradle --exclude-dir=__pycache__ \\\n    \"$CALLBACK_PATTERN\" \"${dirs[@]}\" 2>/dev/null || true)\n  [ -n \"$hits\" ] || return\n  while IFS= read -r line; do\n    violation \"证书校验放行回调：${line#\"$ROOT\"/}\"\n  done <<< \"$hits\"\n}\ncheck_callbacks\n\nif [ \"$VIOLATIONS\" -ne 0 ]; then\n  echo \"grep-guard 失败：$VIOLATIONS 项违例（A10/A14）\" >&2\n  exit 1\nfi\necho \"grep-guard 通过（A10 无证书放行回调；A14 技术栈与 docs 一致）\"\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":253,"cache_creation_input_tokens":0,"cache_read_input_tokens":56704,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"85b5f7a4-f572-472d-8399-89c76017bd29","uuid":"3ba8f944-edaf-49d3-bc99-3d934ad1a7a2","timestamp":"2026-11-02T05:05:07.827Z"}

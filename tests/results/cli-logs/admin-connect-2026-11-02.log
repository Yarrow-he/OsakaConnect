{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_2eQpikmCOHkBEPVG57gI3955","type":"tool_result","content":"1\t# 用途：server-core 后台黑盒测试。起临时自签证书的 8443 后台子进程，验管理身份校验、\n2\t#       健康/版本响应 schema 与单线路约定（A8、A9 后台部分、A15 后台、A17 后台）。\n3\t#       邀请码用 shared/test-vectors/invite-code.json 全向量测后台格式函数。\n4\t# 前置环境：Python 3 + pytest；jsonschema/pyyaml 仅 schema 断言需要（缺则跳过该断言）；\n5\t#           openssl 命令用于运行时生成临时自签证书到 tmp 目录（不入库）。\n6\t# 运行命令：pytest tests/server/server-core -q\n7\t#           入口待写手交付后对齐，可用环境变量覆盖：\n8\t#           OSAKA_SERVER_CMD（默认 \"python -m server\"）、OSAKA_INVITE_FN（默认 \"server.invite.is_valid\"）、\n9\t#           OSAKA_PORT（默认 8443）。\n10\t# 覆盖 acceptance：A8、A9（后台部分）、A15（后台）、A17（后台）。\n11\timport importlib\n12\timport json\n13\timport os\n14\timport pathlib\n15\timport shlex\n16\timport ssl\n17\timport subprocess\n18\timport sys\n19\timport time\n20\timport urllib.error\n21\timport urllib.request\n22\t\n23\timport pytest\n24\t\n25\tROOT = pathlib.Path(__file__).resolve().parents[3]\n26\tSERVER_DIR = ROOT / \"server\"\n27\tSPEC_PATH = ROOT / \"openapi/admin.v1.yaml\"\n28\tINVITE_VECTORS = ROOT / \"shared/test-vectors/invite-code.json\"\n29\t\n30\t# 待写手交付后对齐：入口与邀请码函数名以 server/ 实际实现为准，均可用环境变量覆盖。\n31\tSERVER_CMD = shlex.split(os.environ.get(\"OSAKA_SERVER_CMD\") or f\"{sys.executable} -m server\")\n32\tINVITE_FN = os.environ.get(\"OSAKA_INVITE_FN\", \"server.invite.is_valid\")\n33\t\n34\tHOST = \"127.0.0.1\"\n35\tPORT = int(os.environ.get(\"OSAKA_PORT\", \"8443\"))\n36\tADMIN_TOKEN = \"osaka-test-fake-token-0000\"  # 明显假值，与真实令牌无关\n37\tSTARTUP_TIMEOUT = 10\n38\t\n39\t# server/ 未交付时由 session fixture 统一跳过本模块全部用例（pytest 输出跳过原因，退出码 0）。\n40\t\n41\t\n42\tdef _make_tls_context(tmp_path):\n43\t    cert = tmp_path / \"cert.pem\"\n44\t    key = tmp_path / \"key.pem\"\n45\t    subprocess.run(\n46\t        [\n47\t            \"openssl\", \"req\", \"-x509\", \"-newkey\", \"rsa:2048\", \"-nodes\",\n48\t            \"-keyout\", str(key), \"-out\", str(cert), \"-days\", \"1\",\n49\t            \"-subj\", \"/CN=localhost\",\n50\t            \"-addext\", \"subjectAltName=DNS:localhost,IP:127.0.0.1\",\n51\t        ],\n52\t        check=True,\n53\t        capture_output=True,\n54\t    )\n55\t    return cert, ssl.create_default_context(cafile=str(cert))\n56\t\n57\t\n58\tdef _get(path, context, token=None):\n59\t    request = urllib.request.Request(f\"https://{HOST}:{PORT}{path}\")\n60\t    if token is not None:\n61\t        request.add_header(\"Authorization\", f\"Bearer {token}\")\n62\t    opener = urllib.request.build_opener(\n63\t        urllib.request.ProxyHandler({}),\n64\t        urllib.request.HTTPSHandler(context=context),\n65\t    )\n66\t    try:\n67\t        with opener.open(request, timeout=5) as response:\n68\t            return response.status, json.loads(response.read())\n69\t    except urllib.error.HTTPError as error:\n70\t        return error.code, json.loads(error.read())\n71\t\n72\t\n73\tdef _skip_not_delivered(detail):\n74\t    pytest.skip(f\"待测：模块未交付（{detail}）\")\n75\t\n76\t\n77\t@pytest.fixture(scope=\"session\", autouse=True)\n78\tdef server(tmp_path_factory):\n79\t    if not SERVER_DIR.is_dir():\n80\t        _skip_not_delivered(\"server/ 目录不存在\")\n81\t    tmp_path = tmp_path_factory.mktemp(\"server-core\")\n82\t    try:\n83\t        cert, context = _make_tls_context(tmp_path)\n84\t    except (FileNotFoundError, subprocess.CalledProcessError) as error:\n85\t        _skip_not_delivered(f\"无法用 openssl 生成测试证书：{error}\")\n86\t\n87\t    env = os.environ.copy()\n88\t    env.update(\n89\t        OSAKA_TLS_CERT=str(cert),\n90\t        OSAKA_TLS_KEY=str(tmp_path / \"key.pem\"),\n91\t        OSAKA_ADMIN_TOKEN=ADMIN_TOKEN,\n92\t        OSAKA_PORT=str(PORT),\n93\t    )\n94\t    log_path = tmp_path / \"server.log\"\n95\t    with open(log_path, \"wb\") as log:\n96\t        try:\n97\t            process = subprocess.Popen(SERVER_CMD, cwd=ROOT, env=env, stdout=log, stderr=subprocess.STDOUT)\n98\t        except OSError as error:\n99\t            _skip_not_delivered(f\"后台入口无法启动：{error}\")\n100\t\n101\t        deadline = time.monotonic() + STARTUP_TIMEOUT\n102\t        while time.monotonic() < deadline:\n103\t            if process.poll() is not None:\n104\t                _skip_not_delivered(f\"后台入口退出码 {process.returncode}：{_log_tail(log_path)}\")\n105\t            try:\n106\t                _get(\"/v1/version\", context, token=ADMIN_TOKEN)\n107\t                break\n108\t            except (urllib.error.URLError, ssl.SSLError, OSError, json.JSONDecodeError) as error:\n109\t                last_error = error\n110\t                time.sleep(0.2)\n111\t        else:\n112\t            process.terminate()\n113\t            try:\n114\t                process.wait(timeout=5)\n115\t            except subprocess.TimeoutExpired:\n116\t                process.kill()\n117\t                process.wait()\n118\t            _skip_not_delivered(f\"后台未就绪（{last_error}）：{_log_tail(log_path)}\")\n119\t\n120\t        yield context\n121\t        process.terminate()\n122\t        try:\n123\t            process.wait(timeout=5)\n124\t        except subprocess.TimeoutExpired:\n125\t            process.kill()\n126\t            process.wait()\n127\t\n128\t\n129\tdef _log_tail(path, limit=800):\n130\t    try:\n131\t        text = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n132\t    except OSError:\n133\t        return \"<无日志>\"\n134\t    return text[-limit:].replace(\"\\n\", \" | \")\n135\t\n136\t\n137\tdef _assert_schema(name, body):\n138\t    jsonschema = pytest.importorskip(\"jsonschema\")\n139\t    yaml = pytest.importorskip(\"yaml\")\n140\t    spec = yaml.safe_load(SPEC_PATH.read_text(encoding=\"utf-8\"))\n141\t    schema = {\"$ref\": f\"#/components/schemas/{name}\", \"components\": spec[\"components\"]}\n142\t    errors = sorted(jsonschema.Draft202012Validator(schema).iter_errors(body), key=str)\n143\t    assert not errors, [error.message for error in errors]\n144\t\n145\t\n146\t@pytest.mark.parametrize(\"path\", [\"/v1/health\", \"/v1/version\"])\n147\tdef test_missing_token_is_401_unauthenticated(server, path):\n148\t    status, body = _get(path, server)\n149\t    assert status == 401\n150\t    assert body[\"code\"] == \"UNAUTHENTICATED\"\n151\t    _assert_schema(\"ErrorBody\", body)\n152\t\n153\t\n154\t@pytest.mark.parametrize(\"path\", [\"/v1/health\", \"/v1/version\"])\n155\tdef test_wrong_token_is_403_forbidden(server, path):\n156\t    status, body = _get(path, server, token=\"wrong-token-obviously-fake\")\n157\t    assert status == 403\n158\t    assert body[\"code\"] == \"FORBIDDEN\"\n159\t    _assert_schema(\"ErrorBody\", body)\n160\t\n161\t\n162\tdef test_health_with_token(server):\n163\t    status, body = _get(\"/v1/health\", server, token=ADMIN_TOKEN)\n164\t    assert status == 200\n165\t    assert len(body[\"routes\"]) == 1\n166\t    _assert_schema(\"HealthResponse\", body)\n167\t\n168\t\n169\tdef test_version_with_token(server):\n170\t    status, body = _get(\"/v1/version\", server, token=ADMIN_TOKEN)\n171\t    assert status == 200\n172\t    _assert_schema(\"VersionResponse\", body)\n173\t\n174\t\n175\tdef _invite_validator():\n176\t    module_name, _, attribute = INVITE_FN.rpartition(\".\")\n177\t    sys.path.insert(0, str(ROOT))\n178\t    try:\n179\t        return getattr(importlib.import_module(module_name), attribute)\n180\t    except (ImportError, AttributeError, ValueError):\n181\t        pytest.skip(f\"待测：邀请码函数未交付（INVITE_FN={INVITE_FN} 待对齐）\")\n182\t\n183\t\n184\tdef _accepted(function, sample):\n185\t    try:\n186\t        return bool(function(sample))\n187\t    except (TypeError, ValueError, AttributeError):\n188\t        return False  # 抛异常也属于“拒绝”，与向量 invalid 语义一致\n189\t\n190\t\n191\t_VECTORS = json.loads(INVITE_VECTORS.read_text(encoding=\"utf-8\"))\n192\t_INVITE_CASES = [\n193\t    pytest.param(sample, True, id=f\"valid-{index}\")\n194\t    for index, sample in enumerate(_VECTORS[\"valid\"])\n195\t] + [\n196\t    pytest.param(sample, False, id=f\"invalid-{index}\")\n197\t    for index, sample in enumerate(_VECTORS[\"invalid\"])\n198\t]\n199\t\n200\t\n201\t@pytest.mark.parametrize(\"sample,accepted\", _INVITE_CASES)\n202\tdef test_invite_code_vectors(server, sample, accepted):\n203\t    function = _invite_validator()\n204\t    assert _accepted(function, sample) is accepted\n205\t"}]},"parent_tool_use_id":null,"session_id":"85b5f7a4-f572-472d-8399-89c76017bd29","uuid":"265cf91c-338a-4311-ab82-1645d76e6051","timestamp":"2026-11-02T05:02:21.009Z","tool_use_result":{"type":"text","file":{"filePath":"/home/box/osaka/wt/tests/tests/server/server-core/test_server_core.py","content":"# 用途：server-core 后台黑盒测试。起临时自签证书的 8443 后台子进程，验管理身份校验、\n#       健康/版本响应 schema 与单线路约定（A8、A9 后台部分、A15 后台、A17 后台）。\n#       邀请码用 shared/test-vectors/invite-code.json 全向量测后台格式函数。\n# 前置环境：Python 3 + pytest；jsonschema/pyyaml 仅 schema 断言需要（缺则跳过该断言）；\n#           openssl 命令用于运行时生成临时自签证书到 tmp 目录（不入库）。\n# 运行命令：pytest tests/server/server-core -q\n#           入口待写手交付后对齐，可用环境变量覆盖：\n#           OSAKA_SERVER_CMD（默认 \"python -m server\"）、OSAKA_INVITE_FN（默认 \"server.invite.is_valid\"）、\n#           OSAKA_PORT（默认 8443）。\n# 覆盖 acceptance：A8、A9（后台部分）、A15（后台）、A17（后台）。\nimport importlib\nimport json\nimport os\nimport pathlib\nimport shlex\nimport ssl\nimport subprocess\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\n\nimport pytest\n\nROOT = pathlib.Path(__file__).resolve().parents[3]\nSERVER_DIR = ROOT / \"server\"\nSPEC_PATH = ROOT / \"openapi/admin.v1.yaml\"\nINVITE_VECTORS = ROOT / \"shared/test-vectors/invite-code.json\"\n\n# 待写手交付后对齐：入口与邀请码函数名以 server/ 实际实现为准，均可用环境变量覆盖。\nSERVER_CMD = shlex.split(os.environ.get(\"OSAKA_SERVER_CMD\") or f\"{sys.executable} -m server\")\nINVITE_FN = os.environ.get(\"OSAKA_INVITE_FN\", \"server.invite.is_valid\")\n\nHOST = \"127.0.0.1\"\nPORT = int(os.environ.get(\"OSAKA_PORT\", \"8443\"))\nADMIN_TOKEN = \"osaka-test-fake-token-0000\"  # 明显假值，与真实令牌无关\nSTARTUP_TIMEOUT = 10\n\n# server/ 未交付时由 session fixture 统一跳过本模块全部用例（pytest 输出跳过原因，退出码 0）。\n\n\ndef _make_tls_context(tmp_path):\n    cert = tmp_path / \"cert.pem\"\n    key = tmp_path / \"key.pem\"\n    subprocess.run(\n        [\n            \"openssl\", \"req\", \"-x509\", \"-newkey\", \"rsa:2048\", \"-nodes\",\n            \"-keyout\", str(key), \"-out\", str(cert), \"-days\", \"1\",\n            \"-subj\", \"/CN=localhost\",\n            \"-addext\", \"subjectAltName=DNS:localhost,IP:127.0.0.1\",\n        ],\n        check=True,\n        capture_output=True,\n    )\n    return cert, ssl.create_default_context(cafile=str(cert))\n\n\ndef _get(path, context, token=None):\n    request = urllib.request.Request(f\"https://{HOST}:{PORT}{path}\")\n    if token is not None:\n        request.add_header(\"Authorization\", f\"Bearer {token}\")\n    opener = urllib.request.build_opener(\n        urllib.request.ProxyHandler({}),\n        urllib.request.HTTPSHandler(context=context),\n    )\n    try:\n        with opener.open(request, timeout=5) as response:\n            return response.status, json.loads(response.read())\n    except urllib.error.HTTPError as error:\n        return error.code, json.loads(error.read())\n\n\ndef _skip_not_delivered(detail):\n    pytest.skip(f\"待测：模块未交付（{detail}）\")\n\n\n@pytest.fixture(scope=\"session\", autouse=True)\ndef server(tmp_path_factory):\n    if not SERVER_DIR.is_dir():\n        _skip_not_delivered(\"server/ 目录不存在\")\n    tmp_path = tmp_path_factory.mktemp(\"server-core\")\n    try:\n        cert, context = _make_tls_context(tmp_path)\n    except (FileNotFoundError, subprocess.CalledProcessError) as error:\n        _skip_not_delivered(f\"无法用 openssl 生成测试证书：{error}\")\n\n    env = os.environ.copy()\n    env.update(\n        OSAKA_TLS_CERT=str(cert),\n        OSAKA_TLS_KEY=str(tmp_path / \"key.pem\"),\n        OSAKA_ADMIN_TOKEN=ADMIN_TOKEN,\n        OSAKA_PORT=str(PORT),\n    )\n    log_path = tmp_path / \"server.log\"\n    with open(log_path, \"wb\") as log:\n        try:\n            process = subprocess.Popen(SERVER_CMD, cwd=ROOT, env=env, stdout=log, stderr=subprocess.STDOUT)\n        except OSError as error:\n            _skip_not_delivered(f\"后台入口无法启动：{error}\")\n\n        deadline = time.monotonic() + STARTUP_TIMEOUT\n        while time.monotonic() < deadline:\n            if process.poll() is not None:\n                _skip_not_delivered(f\"后台入口退出码 {process.returncode}：{_log_tail(log_path)}\")\n            try:\n                _get(\"/v1/version\", context, token=ADMIN_TOKEN)\n                break\n            except (urllib.error.URLError, ssl.SSLError, OSError, json.JSONDecodeError) as error:\n                last_error = error\n                time.sleep(0.2)\n        else:\n            process.terminate()\n            try:\n                process.wait(timeout=5)\n            except subprocess.TimeoutExpired:\n                process.kill()\n                process.wait()\n            _skip_not_delivered(f\"后台未就绪（{last_error}）：{_log_tail(log_path)}\")\n\n        yield context\n        process.terminate()\n        try:\n            process.wait(timeout=5)\n        except subprocess.TimeoutExpired:\n            process.kill()\n            process.wait()\n\n\ndef _log_tail(path, limit=800):\n    try:\n        text = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n    except OSError:\n        return \"<无日志>\"\n    return text[-limit:].replace(\"\\n\", \" | \")\n\n\ndef _assert_schema(name, body):\n    jsonschema = pytest.importorskip(\"jsonschema\")\n    yaml = pytest.importorskip(\"yaml\")\n    spec = yaml.safe_load(SPEC_PATH.read_text(encoding=\"utf-8\"))\n    schema = {\"$ref\": f\"#/components/schemas/{name}\", \"components\": spec[\"components\"]}\n    errors = sorted(jsonschema.Draft202012Validator(schema).iter_errors(body), key=str)\n    assert not errors, [error.message for error in errors]\n\n\n@pytest.mark.parametrize(\"path\", [\"/v1/health\", \"/v1/version\"])\ndef test_missing_token_is_401_unauthenticated(server, path):\n    status, body = _get(path, server)\n    assert status == 401\n    assert body[\"code\"] == \"UNAUTHENTICATED\"\n    _assert_schema(\"ErrorBody\", body)\n\n\n@pytest.mark.parametrize(\"path\", [\"/v1/health\", \"/v1/version\"])\ndef test_wrong_token_is_403_forbidden(server, path):\n    status, body = _get(path, server, token=\"wrong-token-obviously-fake\")\n    assert status == 403\n    assert body[\"code\"] == \"FORBIDDEN\"\n    _assert_schema(\"ErrorBody\", body)\n\n\ndef test_health_with_token(server):\n    status, body = _get(\"/v1/health\", server, token=ADMIN_TOKEN)\n    assert status == 200\n    assert len(body[\"routes\"]) == 1\n    _assert_schema(\"HealthResponse\", body)\n\n\ndef test_version_with_token(server):\n    status, body = _get(\"/v1/version\", server, token=ADMIN_TOKEN)\n    assert status == 200\n    _assert_schema(\"VersionResponse\", body)\n\n\ndef _invite_validator():\n    module_name, _, attribute = INVITE_FN.rpartition(\".\")\n    sys.path.insert(0, str(ROOT))\n    try:\n        return getattr(importlib.import_module(module_name), attribute)\n    except (ImportError, AttributeError, ValueError):\n        pytest.skip(f\"待测：邀请码函数未交付（INVITE_FN={INVITE_FN} 待对齐）\")\n\n\ndef _accepted(function, sample):\n    try:\n        return bool(function(sample))\n    except (TypeError, ValueError, AttributeError):\n        return False  # 抛异常也属于“拒绝”，与向量 invalid 语义一致\n\n\n_VECTORS = json.loads(INVITE_VECTORS.read_text(encoding=\"utf-8\"))\n_INVITE_CASES = [\n    pytest.param(sample, True, id=f\"valid-{index}\")\n    for index, sample in enumerate(_VECTORS[\"valid\"])\n] + [\n    pytest.param(sample, False, id=f\"invalid-{index}\")\n    for index, sample in enumerate(_VECTORS[\"invalid\"])\n]\n\n\n@pytest.mark.parametrize(\"sample,accepted\", _INVITE_CASES)\ndef test_invite_code_vectors(server, sample, accepted):\n    function = _invite_validator()\n    assert _accepted(function, sample) is accepted\n","numLines":205,"startLine":1,"totalLines":205}},"tool_result_meta":[{"id":"call_01_2eQpikmCOHkBEPVG57gI3955","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

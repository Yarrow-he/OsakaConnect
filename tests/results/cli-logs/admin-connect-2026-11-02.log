se \"$allowed\" in\n49\t      *\"|$ext|\"*) ;;\n50\t      *) violation \"${f#\"$ROOT\"/}（$label 不允许 .$ext 源码）\" ;;\n51\t    esac\n52\t  done < <(find \"$dir\" -type f | sort)\n53\t}\n54\t\n55\tcheck_lang \"$ROOT/windows\" \"|cs|csproj|xaml|\" \"Windows\"\n56\tcheck_lang \"$ROOT/admin\" \"|cs|csproj|xaml|\" \"管理端\"\n57\tcheck_lang \"$ROOT/android\" \"|kt|kts|\" \"Android\"\n58\tcheck_lang \"$ROOT/server\" \"|py|\" \"后台\"\n59\t\n60\tARCH=\"$ROOT/docs/architecture.md\"\n61\tif [ -f \"$ARCH\" ]; then\n62\t  section=$(awk '/^## 技术栈/{flag=1;next}/^## /{flag=0}flag' \"$ARCH\")\n63\t  for word in \".NET\" \"Kotlin\" \"Python\"; do\n64\t    printf '%s' \"$section\" | grep -Fq \"$word\" || violation \"docs/architecture.md 技术栈一节缺少 $word\"\n65\t  done\n66\tfi\n67\t\n68\tCALLBACK_PATTERN='ServerCertificateCustomValidationCallback|ServerCertificateValidationCallback|DangerousAcceptAnyServerCertificateValidator|RemoteCertificateValidationCallback'\n69\tcheck_callbacks() {\n70\t  local dirs=() d hits\n71\t  for d in windows admin android server; do\n72\t    [ -d \"$ROOT/$d\" ] && dirs+=(\"$ROOT/$d\")\n73\t  done\n74\t  [ ${#dirs[@]} -eq 0 ] && return\n75\t  hits=$(grep -RInE \\\n76\t    --exclude-dir=bin --exclude-dir=obj --exclude-dir=build --exclude-dir=.gradle --exclude-dir=__pycache__ \\\n77\t    \"$CALLBACK_PATTERN\" \"${dirs[@]}\" 2>/dev/null || true)\n78\t  [ -n \"$hits\" ] || return\n79\t  while IFS= read -r line; do\n80\t    violation \"证书校验放行回调：${line#\"$ROOT\"/}\"\n81\t  done <<< \"$hits\"\n82\t}\n83\tcheck_callbacks\n84\t\n85\tif [ \"$VIOLATIONS\" -ne 0 ]; then\n86\t  echo \"grep-guard 失败：$VIOLATIONS 项违例（A10/A14）\" >&2\n87\t  exit 1\n88\tfi\n89\techo \"grep-guard 通过（A10 无证书放行回调；A14 技术栈与 docs 一致）\"\n90\t"}]},"parent_tool_use_id":null,"session_id":"85b5f7a4-f572-472d-8399-89c76017bd29","uuid":"c8a77895-e802-4036-add1-fc95896d9d8c","timestamp":"2026-11-02T05:05:33.891Z","tool_use_result":{"type":"text","file":{"filePath":"/home/box/osaka/wt/tests/tests/admin/admin-connect/
```\n\nBut then `_make_tls_context` won't run. Good.\n\nAlso `_skip_not_delivered` uses pytest.skip inside fixture — fine.\n\nLet me edit and re-run.","signature":"cd47d167-8ad8-4cc5-987d-6808aed9e76b"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":186,"cache_creation_input_tokens":0,"cache_read_input_tokens":31744,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f8aecac3-2429-4d90-a000-406275e88d92","uuid":"54013d89-cb4c-4264-aac2-e2502ded2354","timestamp":"2026-11-02T05:00:23.613Z","thinking_duration_ms":3479,"thinking_display":"updates"}

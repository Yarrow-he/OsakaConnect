\n    jsonschema.Draft202012Validator(schema).validate(body)\n\n@pytest.mark.parametrize(\"path\", [\"/v1/health\", \"/v1/version\"])\ndef test_missing_credentials_401(server, path):\n    status, body = get(server, path)\n    assert status == 401\n    assert_schema(\"ErrorBody\", body)\n    assert body[\"code\"] == \"UNAUTHENTICATED\"\n\n@pytest.mark.parametrize(\"path\", [\"/v1/health\", \"/v1/version\"])\ndef test_wrong_token_403(server, path):\n    status, body = get(server, path, WRONG_TOKEN)\n    assert status == 403\n    assert_schema(\"ErrorBody\", body)\n    assert body[\"code\"] == \"FORBIDDEN\"\n\ndef test_health_ok(server):\n    status, body = get(server, \"/v1/health\", ADMIN_TOKEN)\n    assert status == 200\n    assert_schema(\"HealthResponse\", body)\n    assert len(body[\"routes\"]) == 1\n\ndef test_version_ok(server):\n    status, body = get(server, \"/v1/version\", ADMIN_TOKEN)\n    assert status == 200\n    assert_schema(\"VersionResponse\", body)\n\ndef _invite_fn():\n    module_name, _, attr = INVITE_FN.partition(\":\")\n    if not attr:\n        module_name, _, attr = INVITE_FN.rpartition(\".\")\n    try:\n        module = importlib.import_module(module_name)\n        return getattr(module, attr)\n    except (ImportError, AttributeError):\n        pytest.skip(f\"待测：模块未交付（邀请码函数 {INVITE_FN} 未就绪）\")\n\nCASES = [pytest.param(code, True, id=f\"valid-{i}\") ...]\n```\nParam IDs may contain weird chars/newlines? vectors no newline. For None id need custom. Use ids via enumerate and repr? pytest ids must be strings; f\"valid-{i}-{code!r}\" includes slashes? no. Keep simple f\"valid-{i}\" / f\"invalid-{i}\".\n\n```\nCASES = [pytest.param(c, True, id=f\"valid-{i}\") for i,c in enumerate(VECTORS[\"valid\"])] + ...\n@pytest.mark.parametrize(\"code,expected\", CASES)\ndef test_invite_code_vectors(code, expected):\n    fn = _invite_fn()\n    assert fn(code) is expected\n```\n`fn(None)` may raise rather than return False; product should handle null vector. Should we treat exception as fail? The vector says invalid, so raise = fail. Assert with == expected rather than `is` (bool vs numpy). Use `assert fn(code) == expected`.\n\nImport http.client and importlib in header.\n\nNote `from conftest import ... server` — importing fixtures isn't needed; only constants. Don't import server fixture. Remove server from imports.\n\nPotential issue: `from conftest import ...` may import a different conftest module if pytest imported it as \"tests.server.server-core.conftest\" (importlib mode not default). Default prepend: conftest is loaded as top-level \"conftest\" only if no __init__.py. Actually pytest imports conftest using import_path with mode; with prepend, it inserts basedir and imports module name \"conftest\". The test module itself is imported later as \"test_server_core\", and sys.path contains the dir, so `import conftest` finds the same file (already in sys.modules). Good.\n\nMaybe avoid `pytest.importorskip` at module top before pytestmark; it's fine.\n\nOne more consideration: module-level skipif means when server/ absent, conftest fixture won't even run; invitation test skip too. Good.\n\nNow write via bash heredoc. Since approval required, craft a single robust command:\n\n```\nmkdir -p ... \ncat > .../conftest.py <<'PY'\n...\nPY\ncat > .../test_server_core.py <<'PY'\n...\nPY\n```\n\nNo `cd` needed (absolute paths). Let me issue.","signature":"ca4ef1fa-ee90-4414-85e4-93635ca6dd9a"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":218,"cache_creation_input_tokens":0,"cache_read_input_tokens":26880,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3e5a2223-e15b-4c88-b49d-cba1421dd02d","uuid":"f5d176ba-c0b8-4006-9d85-863d98b7162e","timestamp":"2026-11-02T04:55:33.489Z","thinking_duration_ms":6817,"thinking_display":"updates"}
{"type":"assistant","message":{"id":"ca4ef1fa-ee90-4414-85e4-93635ca6dd9a","type":"message","role":"assistant","model":"deepseek-flash","content":[{"type":"tool_use","id":"call_00_ZGP915iuiGVTlxliOs615598","name":"Bash","input":{"command":"mkdir -p /home/box/osaka/wt/tests/tests/server/server-core && cat > /home/box/osaka/wt/tests/tests/server/server-core/conftest.py <<'PY'\n# 用途：server-core 黑盒测试的共享夹具——生成临时自签证书、以子进程启动后台、提供信任该证书的 HTTPS 上下文。\n# 前置环境：python3 + pytest + openssl；后台入口为 SERVER_CMD（默认 `python3 -m server.main`，可用 OSAKA_SERVER_CMD 覆盖）。\n# 运行命令：python3 -m pytest tests/server/server-core -v\n# 覆盖 acceptance：A8、A9、A15、A17（后台部分）。\n# 注意：证书与私钥只在运行时写入 tmp_path，不进仓库；令牌为明显假值，只用于测试进程环境。\nimport http.client\nimport os\nimport pathlib\nimport shlex\nimport ssl\nimport subprocess\nimport time\n\nimport pytest\n\nROOT = pathlib.Path(__file__).resolve().parents[3]  # 仓库根\nSERVER_DIR = ROOT / \"server\"\n\n# 待写手交付后对齐：入口与邀请码函数名由环境变量覆盖。\nSERVER_CMD = shlex.split(os.environ.get(\"OSAKA_SERVER_CMD\", \"python3 -m server.main\"))\nINVITE_FN = os.environ.get(\"OSAKA_INVITE_FN\", \"server.invite.is_valid\")\nPORT = int(os.environ.get(\"OSAKA_SERVER_PORT\", \"8443\"))\nADMIN_TOKEN = \"fake-admin-token-for-tests\"  # 明显假值\nWRONG_TOKEN = \"wrong-fake-token\"\n\n\ndef _make_cert(cert: pathlib.Path, key: pathlib.Path):\n    return subprocess.run(\n        [\n            \"openssl\", \"req\", \"-x509\", \"-newkey\", \"rsa:2048\", \"-sha256\",\n            \"-days\", \"1\", \"-nodes\",\n            \"-keyout\", str(key), \"-out\", str(cert),\n            \"-subj\", \"/CN=localhost\",\n            \"-addext\", \"subjectAltName=DNS:localhost,IP:127.0.0.1\",\n        ],\n        capture_output=True,\n    )\n\n\n@pytest.fixture(scope=\"session\")\ndef server(tmp_path_factory):\n    if not SERVER_DIR.is_dir():\n        pytest.skip(\"待测：模块未交付\")\n\n    work = tmp_path_factory.mktemp(\"server-core\")\n    cert, key = work / \"cert.pem\", work / \"key.pem\"\n    made = _make_cert(cert, key)\n    if made.returncode != 0:\n        pytest.skip(f\"待测：无法生成测试证书: {made.stderr.decode(errors='replace')[:300]}\")\n\n    env = os.environ.copy()\n    env.update(\n        OSAKA_TLS_CERT=str(cert),\n        OSAKA_TLS_KEY=str(key),\n        OSAKA_ADMIN_TOKEN=ADMIN_TOKEN,\n        OSAKA_PORT=str(PORT),\n    )\n    log_path = work / \"server.log\"\n    log = log_path.open(\"wb\")\n    proc = subprocess.Popen(SERVER_CMD, cwd=ROOT, env=env, stdout=log, stderr=subprocess.STDOUT)\n\n    ctx = ssl.create_default_context(cafile=str(cert))\n    deadline = time.time() + 15\n    ready = False\n    while time.time() < deadline:\n        if proc.poll() is not None:\n            break\n        try:\n            conn = http.client.HTTPSConnection(\"127.0.0.1\", PORT, context=ctx, timeout=2)\n            conn.request(\"GET\", \"/v1/health\")\n            conn.getresponse().read()\n            conn.close()\n            ready = True\n            break\n        except (OSError, ssl.SSLError):\n            time.sleep(0.2)\n\n    if not ready:\n        proc.terminate()\n        try:\n            proc.wait(timeout=5)\n        except subprocess.TimeoutExpired:\n            proc.kill()\n            proc.wait()\n        log.close()\n        tail = log_path.read_text(encoding=\"utf-8\", errors=\"replace\")[-500:]\n        pytest.skip(f\"待测：模块未交付（入口不可启动）: {' '.join(SERVER_CMD)}\\n{tail}\")\n\n    yield {\"host\": \"127.0.0.1\", \"port\": PORT, \"ctx\": ctx, \"token\": ADMIN_TOKEN, \"log\": str(log_path)}\n\n    proc.terminate()\n    try:\n        proc.wait(timeout=5)\n    except subprocess.TimeoutExpired:\n        proc.kill()\n        proc.wait()\n    log.close()\nPY\ncat > /home/box/osaka/wt/tests/tests/server/server-core/test_server_core.py <<'PY'\n# 用途：server-core 后台黑盒测试——HTTPS 下的 401/403/200、响应 schema、routes 长度、邀请码格式向量。\n# 前置环境：python3 + pytest + pyyaml + jsonschema + openssl；server/ 未交付时整个模块 skip（不伪造通过）。\n# 运行命令：python3 -m pytest tests/server/server-core -v\n# 覆盖 acceptance：A8、A9、A15、A17（后台部分）。\nimport http.client\nimport importlib\nimport json\nimport pathlib\n\nimport pytest\n\npytest.importorskip(\"yaml\")\npytest.importorskip(\"jsonschema\")\nimport jsonschema  # noqa: E402\nimport yaml  # noqa: E402\n\nfrom conftest import ADMIN_TOKEN, INVITE_FN, SERVER_DIR, WRONG_TOKEN  # noqa: E402\n\nROOT = pathlib.Path(__file__).resolve().parents[3]\nSPEC = yaml.safe_load((ROOT / \"openapi/admin.v1.yaml\").read_text(encoding=\"utf-8\"))\nVECTORS = json.loads((ROOT / \"shared/test-vectors/invite-code.json\").read_text(encoding=\"utf-8\"))\n\npytestmark = pytest.mark.skipif(not SERVER_DIR.is_dir(), reason=\"待测：模块未交付\")\n\n\ndef get(srv, path, token=None):\n    headers = {\"Authorization\": f\"Bearer {token}\"} if token is not None else {}\n    conn = http.client.HTTPSConnection(srv[\"host\"], srv[\"port\"], context=srv[\"ctx\"], timeout=5)\n    conn.request(\"GET\", path, headers=headers)\n    resp = conn.getresponse()\n    body = resp.read()\n    conn.close()\n    return resp.status, json.loads(body) if body else None\n\n\ndef assert_schema(name, body):\n    schema = {\"$ref\": f\"#/components/schemas/{name}\", \"components\": SPEC[\"components\"]}\n    jsonschema.Draft202012Validator(schema).validate(body)\n\n\n@pytest.mark.parametrize(\"path\", [\"/v1/health\", \"/v1/version\"])\ndef test_missing_credentials_401(server, path):\n    status, body = get(server, path)\n    assert status == 401, body\n    assert_schema(\"ErrorBody\", body)\n    assert body[\"code\"] == \"UNAUTHENTICATED\"\n\n\n@pytest.mark.parametrize(\"path\", [\"/v1/health\", \"/v1/version\"])\ndef test_wrong_token_403(server, path):\n    status, body = get(server, path, WRONG_TOKEN)\n    assert status == 403, body\n    assert_schema(\"ErrorBody\", body)\n    assert body[\"code\"] == \"FORBIDDEN\"\n\n\ndef test_health_ok(server):\n    status, body = get(server, \"/v1/health\", ADMIN_TOKEN)\n    assert status == 200, body\n    assert_schema(\"HealthResponse\", body)\n    assert len(body[\"routes\"]) == 1  # A17：一期恰为一条线路\n\n\ndef test_version_ok(server):\n    status, body = get(server, \"/v1/version\", ADMIN_TOKEN)\n    assert status == 200, body\n    assert_schema(\"VersionResponse\", body)\n\n\ndef _invite_fn():\n    module_name, _, attr = INVITE_FN.partition(\":\")\n    if not attr:\n        module_name, _, attr = INVITE_FN.rpartition(\".\")\n    try:\n        return getattr(importlib.import_module(module_name), attr)\n    except (ImportError, AttributeError):\n        pytest.skip(f\"待测：模块未交付（邀请码函数 {INVITE_FN} 未就绪）\")\n\n\nCASES = [pytest.param(code, True, id=f\"valid-{i}\") for i, code in enumerate(VECTORS[\"valid\"])]\nCASES += [pytest.param(code, False, id=f\"invalid-{i}\") for i, code in enumerate(VECTORS[\"invalid\"])]\n\n\n@pytest.mark.parametrize(\"code,expected\", CASES)\ndef test_invite_code_vectors(code, expected):\n    assert _invite_fn()(code) == expected\nPY","description":"Create conftest.py and test_server_core.py"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":218,"cache_creation_input_tokens":0,"cache_read_input_tokens":26880,"output_tokens":0,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3e5a2223-e15b-4c88-b49d-cba1421dd02d","uuid":"c5f2dbdc-8295-4070-9c11-de4fefeada50","timestamp":"2026-11-02T04:55:39.512Z"}

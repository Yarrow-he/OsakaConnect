{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_cdkvi8d7O040JtNWRaUt1545","type":"tool_result","content":"1\t# 契约测试：openapi/admin.v1.yaml 合法，且 shared/test-vectors/admin-contract.json 正反例结果符合预期。\n2\t# CI 依赖（仅测试）：pyyaml、jsonschema、openapi-spec-validator。\n3\timport json, pathlib, yaml, jsonschema, pytest\n4\tfrom openapi_spec_validator import validate\n5\t\n6\tROOT = pathlib.Path(__file__).resolve().parents[2]\n7\tSPEC = yaml.safe_load((ROOT / \"openapi/admin.v1.yaml\").read_text(encoding=\"utf-8\"))\n8\tVEC = json.loads((ROOT / \"shared/test-vectors/admin-contract.json\").read_text(encoding=\"utf-8\"))\n9\t\n10\tdef test_spec_valid():\n11\t    validate(SPEC)\n12\t\n13\tdef schema(name):\n14\t    return {\"$ref\": f\"#/components/schemas/{name}\", \"components\": SPEC[\"components\"]}\n15\t\n16\tCASES = [(n, s, ok) for n, v in VEC.items() if not n.startswith(\"_\") for ok in (True, False) for s in v[\"valid\" if ok else \"invalid\"]]\n17\t\n18\t@pytest.mark.parametrize(\"name,sample,ok\", CASES)\n19\tdef test_vectors(name, sample, ok):\n20\t    v = jsonschema.Draft202012Validator(schema(name))\n21\t    assert v.is_valid(sample) == ok, (name, sample)\n22\t"}]},"parent_tool_use_id":null,"session_id":"3e5a2223-e15b-4c88-b49d-cba1421dd02d","uuid":"6aff6156-a6bf-40de-80c4-7af49c21f28d","timestamp":"2026-11-02T04:54:43.975Z","tool_use_result":{"type":"text","file":{"filePath":"/home/box/osaka/wt/tests/tests/contract/test_contract.py","content":"# 契约测试：openapi/admin.v1.yaml 合法，且 shared/test-vectors/admin-contract.json 正反例结果符合预期。\n# CI 依赖（仅测试）：pyyaml、jsonschema、openapi-spec-validator。\nimport json, pathlib, yaml, jsonschema, pytest\nfrom openapi_spec_validator import validate\n\nROOT = pathlib.Path(__file__).resolve().parents[2]\nSPEC = yaml.safe_load((ROOT / \"openapi/admin.v1.yaml\").read_text(encoding=\"utf-8\"))\nVEC = json.loads((ROOT / \"shared/test-vectors/admin-contract.json\").read_text(encoding=\"utf-8\"))\n\ndef test_spec_valid():\n    va
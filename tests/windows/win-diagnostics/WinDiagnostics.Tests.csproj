<Project Sdk="Microsoft.NET.Sdk">
  <!--
    用途：win-diagnostics 的 xUnit 测试工程，覆盖 A3（错误文案）、A4（日志脱敏）、A15（邀请码）。
    前置环境：Windows + .NET 8 SDK；共享向量从仓库 shared/ 按相对路径读取。
    运行命令：dotnet test tests/windows/win-diagnostics -c Release
    覆盖 acceptance：A3、A4、A15
    待 CI：本机不装 .NET，未在本机构建/运行；由 GitHub Actions windows-latest 执行。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    待写手交付后对齐：产品工程路径。文件存在才引用；不存在时测试在发现阶段
    以“待测：模块未交付”跳过（退出码 0），不会伪装通过。
    CI 也可用 -p:ProductProject=<路径> 覆盖。
  -->
  <PropertyGroup>
    <ProductProject Condition="'$(ProductProject)' == ''">$(MSBuildThisFileDirectory)..\..\..\windows\OsakaConnect.Windows\OsakaConnect.Windows.csproj</ProductProject>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(ProductProject)')">
    <ProjectReference Include="$(ProductProject)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 产品未交付时在 dotnet test 输出里明确提示，避免只看摘要时误以为已测。 -->
  <Target Name="AnnounceProductMissing" BeforeTargets="VSTest">
    <Message Importance="high" Condition="!Exists('$(ProductProject)')"
             Text="待测：模块未交付（win-diagnostics；未找到 $(ProductProject)）" />
  </Target>
</Project>

+"""Run with python3 -m osaka_server.app from server/."""
+
+import hmac
+import json
+import os
+from pathlib import Path
+import ssl
+import sys
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+from .schema import ERROR_CODES, validate
+
+
+ERRORS_PATH = Path(__file__).resolve().parents[2] / "shared" / "errors.json"
+
+
+def make_handler():
+    """Capture environment configuration once at startup."""
+    token = os.environ.get("OSAKA_ADMIN_TOKEN")
+    if not token:
+        raise ValueError("Missing required environment variable: OSAKA_ADMIN_TOKEN")
+    token = token.encode("utf-8")
+    try:
+        errors = json.loads(ERRORS_PATH.read_text(encoding="utf-8"))
+        error_bodies = {
+            code: {"code": code, "message": errors[code]["zh"]}
+            for code in ERROR_CODES
+        }
+        if not all(validate("ErrorBody", body) for body in error_bodies.values()):
+            raise ValueError
+    except (OSError, ValueError, KeyError, TypeError):
+        raise ValueError("Invalid shared error catalog") from None
+
+    health = {
+        "status": "ok",
+        "routes": [{
+            "id": os.environ.get("OSAKA_ROUTE_ID", "placeholder-route"),
+            "display_name": os.environ.get("OSAKA_ROUTE_NAME", "Placeholder route"),
+        }],
+    }
+
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, format, *args):
+            # Requests and headers may contain credentials; do not log them.
+            pass
+
+        def _send_json(self, status, schema, body):
+            if not validate(schema, body):
+                status = 500
+                body = error_bodies["INTERNAL"]
+                if not validate("ErrorBody", body):
+                    raise ValueError("Invalid internal error response")
+            payload = json.dumps(body, ensure_ascii=True).encode("utf-8")
+            self.send_response(status)
+            self.send_header("Content-Type", "application/json; charset=utf-8")
+            self.send_header("Content-Length", str(len(payload)))
+            self.end_headers()
+            self.wfile.write(payload)
+
+        def do_GET(self):
+            if self.path not in ("/v1/health", "/v1/version"):
+                self.send_response(404)
+                self.send_header("Content-Length", "0")
+                self.end_headers()
+                return
+            headers = self.headers.get_all("Authorization", [])
+            if not headers or (len(headers) == 1 and not headers[0].strip()):
+                self._send_json(401, "ErrorBody", error_bodies["UNAUTHENTICATED"])
+                return
+            parts = headers[0].split()
+            if (
+                len(headers) != 1 or len(parts) != 2
+                or parts[0].lower() != "bearer"
+                or not hmac.compare_digest(parts[1].encode("utf-8"), token)
+            ):
+                self._send_json(403, "ErrorBody", error_bodies["FORBIDDEN"])
+                return
+            if self.path == "/v1/health":
+                self._send_json(200, "HealthResponse", health)
+            else:
+                self._send_json(200, "VersionResponse", {
+                    "service": "osaka-server",
+                    "version": "0.1.0",
+                    "protocol": "admin.v1",
+                })
+
+    return Handler
+
+
+def make_server(address=("0.0.0.0", 8443)):
+    for name in ("OSAKA_TLS_CERT", "OSAKA_TLS_KEY", "OSAKA_ADMIN_TOKEN"):
+        if not os.environ.get(name):
+            raise ValueError(f"Missing required environment variable: {name}")
+    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+    try:
+        context.load_cert_chain(os.environ["OSAKA_TLS_CERT"], os.environ["OSAKA_TLS_KEY"])
+    except (OSError, ValueError, ssl.SSLError):
+        raise ValueError("Unable to load TLS certificate/key") from None
+    server = ThreadingHTTPServer(address, make_handler())
+    try:
+        server.socket = context.wrap_socket(server.socket, server_side=True)
+    except Exception:
+        server.server_close()
+        raise
+    return server
+
+
+def main():
+    try:
+        server = make_server()
+    except ValueError as error:
+        print(f"Startup failed: {error}", file=sys.stderr)
+        return 1
+    except OSError:
+        print("Startup failed: unable to start HTTPS listener", file=sys.stderr)
+        return 1
+    with server:
+        try:
+            server.serve_forever()
+        except KeyboardInterrupt:
+            pass
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

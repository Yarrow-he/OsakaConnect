+"""ASCII Crockford Base32 invite codes."""
+
+import re
+
+
+def normalize(value):
+    """Return the stripped uppercase code, or None for invalid input."""
+    if not isinstance(value, str) or not value.isascii():
+        return None
+    value = value.strip().upper()
+    return value if re.fullmatch(r"[0-9A-HJKMNP-TV-Z]{8}", value) else None
+
+
+def is_valid_invite_code(value):
+    return normalize(value) is not None

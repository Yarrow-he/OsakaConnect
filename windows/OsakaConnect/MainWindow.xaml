<Window x:Class="OsakaConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OsakaConnect" Width="800" Height="500"
        MinWidth="480" MinHeight="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="Navigation" AutomationProperties.Name="侧栏导航"
                 SelectionMode="Single" SelectionChanged="Navigation_SelectionChanged">
            <ListBoxItem Content="连接" Padding="16" />
            <ListBoxItem Content="设置" Padding="16" />
        </ListBox>
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="24"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
